# Copy to .env and fill in. See README/setup notes for where each value comes from.

DATABASE_URL="postgresql://user:password@localhost:5432/sitecontrol?schema=public"

# Required for `prisma migrate dev`. Point this at a genuinely empty
# database — NOT one named `template1` (Postgres clones template1's
# current contents into any new database by default, which breaks the
# shadow-diffing `migrate dev` relies on). With `npx prisma dev`, create
# one once with: CREATE DATABASE shadow_db TEMPLATE template0;
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/shadow_db?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Microsoft Entra ID (Azure AD) app registration
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0/"
